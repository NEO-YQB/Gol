datasource db {
  provider = "postgresql"
  url      = env("MY_NEW_DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int      @id @default(autoincrement())
  phoneNumber   String   @unique
  email         String?  @unique
  fullName      String?
  isActive      Boolean  @default(true)
  
  roles         UsersOnRoles[]

  addresses     UserAddress[]
  cart          Cart?
  store         Store?
  orders        Order[]
  payments      Payment[]
  couponRedemptions CouponRedemption[]
  supportTickets SupportTicket[]
  reviews       Review[]
  notifications Notification[]
  notificationDeliveries NotificationDelivery[]
  authoredArticles Article[]
  contentAuthor Author?
  vendorOnboardingRequest VendorOnboardingRequest? @relation("VendorOnboardingOwner")
  vendorOnboardingReviewedRequests VendorOnboardingRequest[] @relation("VendorOnboardingReviewedBy")
  vendorOnboardingProductReviewedRequests VendorOnboardingRequest[] @relation("VendorOnboardingProductReviewedBy")
  reviewedProducts Product[] @relation("ProductReviewedBy")
  publishedProducts Product[] @relation("ProductPublishedBy")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique 
  label       String?  
  description String?

  users       UsersOnRoles[]
  permissions RolesOnPermissions[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id          Int      @id @default(autoincrement())
  action      String   
  subject     String   
  inverted    Boolean  @default(false) 
  conditions  Json?    

  roles       RolesOnPermissions[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([action, subject])
}

model UsersOnRoles {
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolesOnPermissions {
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Store {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  description   String?  @db.Text
  logo          String?
  lat           Float?
  lng           Float?
  address       String?
  isVerified    Boolean  @default(false)
  sameDayDelivery Boolean @default(false)
  hasExpressDelivery Boolean @default(false)
  minDeliveryHours Int?
  maxDeliveryHours Int?
  expressDeliveryHours Int?
  deliveryWindows Json?
  customerRatingAverage Decimal @default(0) @db.Decimal(3, 2)
  customerRatingCount Int @default(0)
  vendorHealthScore Int @default(100)
  vendorHealthStatus VendorHealthStatus @default(GOOD)
  vendorHealthCalculatedAt DateTime?
  vendorHealthSnapshot Json?
  
  ownerId       Int      @unique
  owner         User     @relation(fields: [ownerId], references: [id])
  products      Product[]
  orders        Order[]
  commissionRules CommissionRule[]
  wallet        StoreWallet?
  walletTransactions WalletTransaction[]
  supportTickets SupportTicket[]
  domainEvents   DomainEvent[]
  vendorDiscounts VendorDiscount[]
  promotions    PromotionOnStores[]
  couponScopes  CouponOnStores[]
  notifications Notification[]
  notificationDeliveries NotificationDelivery[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserAddress {
  id        Int      @id @default(autoincrement())
  title     String
  address   String   @db.Text
  city      String
  lat       Float
  lng       Float
  isDefault Boolean  @default(false)
  
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId     Int       @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model CartItem {
  id         Int      @id @default(autoincrement())
  cartId     Int
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
}

enum ElementType {
  BASE
  FLOWER
  FILLER
  ACCESSORY
}

model Product {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  shortDescription String? @db.Text
  quantity        Int      @default(0)
  price           Float
  discountPrice   Float?
  mainImage       String
  mainImageAlt    String?
  images          Json?
  gallery         Json?
  videoUrl        String?
  publicationStatus ProductPublicationStatus @default(DRAFT)
  isPurchasable   Boolean  @default(false)
  isArchived      Boolean  @default(false)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedByUserId Int?
  reviewNote      String?  @db.Text
  approvedAt      DateTime?
  publishedAt     DateTime?
  publishedByUserId Int?

  storeId         Int
  store           Store    @relation(fields: [storeId], references: [id])
  productTypeId   Int
  productType     ProductType @relation(fields: [productTypeId], references: [id])
  categoryId      Int
  category        Category    @relation(fields: [categoryId], references: [id])

  composition     ProductComposition[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  vendorDiscounts VendorDiscount[]
  promotions      PromotionOnProducts[]
  couponScopes    CouponOnProducts[]
  reviewedByUser  User?    @relation("ProductReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  publishedByUser User?    @relation("ProductPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  metaTitle       String?
  metaDescription String?
  isIndexed       Boolean     @default(true)
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([publicationStatus, updatedAt])
  @@index([storeId, publicationStatus, updatedAt])
  @@index([isPurchasable, isArchived])
}

model ProductType {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  image           String?
  metaTitle       String?
  metaDescription String?
  isIndexed       Boolean  @default(true)
  allowedElements Json?    
  products        Product[]
  createdAt       DateTime @default(now())
}

model Category {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  image           String?
  parentId        Int?
  parent          Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryToCategory")
  metaTitle       String?
  metaDescription String?
  isIndexed       Boolean  @default(true)
  isCampaign      Boolean  @default(false)
  products        Product[]
  promotions      PromotionOnCategories[]
  couponScopes    CouponOnCategories[]
  createdAt       DateTime @default(now())
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model Author {
  id              Int       @id @default(autoincrement())
  name            String
  slug            String    @unique
  bio             String?   @db.Text
  avatarImage     String?
  seoBio          String?   @db.Text
  isActive        Boolean   @default(true)
  userId          Int?      @unique
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  articles        Article[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ArticleCategory {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  description     String?   @db.Text
  introText       String?   @db.Text
  parentId        Int?
  parent          ArticleCategory? @relation("ArticleCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        ArticleCategory[] @relation("ArticleCategoryTree")
  coverImage      String?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  robotsIndex     Boolean   @default(true)
  robotsFollow    Boolean   @default(true)
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  articles        Article[]
  redirects       ArticleCategorySlugRedirect[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ArticleTag {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  description     String?   @db.Text
  introText       String?   @db.Text
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  robotsIndex     Boolean   @default(true)
  robotsFollow    Boolean   @default(true)
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  articles        ArticleTagOnArticles[]
  redirects       ArticleTagSlugRedirect[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Article {
  id              Int             @id @default(autoincrement())
  title           String
  slug            String          @unique
  excerpt         String?         @db.Text
  coverImage      String?
  content         String          @db.Text
  focusKeyword    String?
  seoNotes        String?         @db.Text
  readingTimeMinutes Int?
  tableOfContents Json?
  status          ArticleStatus   @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  robotsIndex     Boolean         @default(true)
  robotsFollow    Boolean         @default(true)
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  authorId        Int
  author          Author          @relation(fields: [authorId], references: [id])
  categoryId      Int
  category        ArticleCategory @relation(fields: [categoryId], references: [id])
  tags            ArticleTagOnArticles[]
  createdByUserId Int?
  createdByUser   User?           @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, publishedAt])
  @@index([authorId, createdAt])
  @@index([categoryId, createdAt])
  @@index([focusKeyword])
}

model ArticleTagOnArticles {
  articleId Int
  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tagId     Int
  tag       ArticleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([articleId, tagId])
  @@index([tagId, articleId])
}

model ArticleCategorySlugRedirect {
  id         Int             @id @default(autoincrement())
  fromSlug   String          @unique
  categoryId Int
  category   ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
}

model ArticleTagSlugRedirect {
  id        Int        @id @default(autoincrement())
  fromSlug  String     @unique
  tagId     Int
  tag       ArticleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
}

enum DiscountValueType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountLayer {
  VENDOR
  PLATFORM
  COUPON
}

enum PromotionScopeType {
  PRODUCT
  STORE
  CATEGORY
}

enum CouponApplyOn {
  BASE_SUBTOTAL
  DISCOUNTED_SUBTOTAL
}

model VendorDiscount {
  id                    Int               @id @default(autoincrement())
  productId             Int
  product               Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId               Int
  store                 Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title                 String
  description           String?           @db.Text
  valueType             DiscountValueType
  value                 Decimal           @db.Decimal(12, 2)
  priority              Int               @default(100)
  isActive              Boolean           @default(true)
  isExclusive           Boolean           @default(false)
  allowCouponStacking   Boolean           @default(false)
  startAt               DateTime?
  endAt                 DateTime?
  metadata              Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([productId, isActive])
  @@index([storeId, isActive])
}

model PlatformPromotion {
  id                           Int                  @id @default(autoincrement())
  title                        String
  description                  String?              @db.Text
  layer                        DiscountLayer        @default(PLATFORM)
  valueType                    DiscountValueType
  value                        Decimal              @db.Decimal(12, 2)
  priority                     Int                  @default(100)
  isActive                     Boolean              @default(true)
  isExclusive                  Boolean              @default(false)
  allowVendorDiscountStacking  Boolean              @default(false)
  allowCouponStacking          Boolean              @default(false)
  promotedVisibility           Boolean              @default(false)
  startAt                      DateTime?
  endAt                        DateTime?
  createdByUserId              Int?
  metadata                     Json?
  products                     PromotionOnProducts[]
  stores                       PromotionOnStores[]
  categories                   PromotionOnCategories[]
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  @@index([isActive, priority])
}

model PromotionOnProducts {
  promotionId Int
  promotion   PlatformPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
}

model PromotionOnStores {
  promotionId Int
  promotion   PlatformPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  storeId     Int
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([promotionId, storeId])
}

model PromotionOnCategories {
  promotionId Int
  promotion   PlatformPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  categoryId  Int
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
}

model Coupon {
  id                            Int               @id @default(autoincrement())
  code                          String            @unique
  title                         String
  description                   String?           @db.Text
  layer                         DiscountLayer     @default(COUPON)
  valueType                     DiscountValueType
  value                         Decimal           @db.Decimal(12, 2)
  priority                      Int               @default(100)
  isActive                      Boolean           @default(true)
  isExclusive                   Boolean           @default(true)
  applyOn                       CouponApplyOn     @default(DISCOUNTED_SUBTOTAL)
  firstOrderOnly                Boolean           @default(false)
  minOrderAmount                Decimal?          @db.Decimal(12, 2)
  usageLimit                    Int?
  perUserUsageLimit             Int?
  allowVendorDiscountStacking   Boolean           @default(false)
  allowPlatformPromotionStacking Boolean          @default(false)
  startAt                       DateTime?
  endAt                         DateTime?
  createdByUserId               Int?
  metadata                      Json?
  products                      CouponOnProducts[]
  stores                        CouponOnStores[]
  categories                    CouponOnCategories[]
  redemptions                   CouponRedemption[]
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt

  @@index([isActive, priority])
}

model CouponRedemption {
  id         Int      @id @default(autoincrement())
  couponId    Int
  coupon      Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([couponId, userId])
  @@unique([orderId])
}

model CouponOnProducts {
  couponId  Int
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
}

model CouponOnStores {
  couponId Int
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  storeId  Int
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([couponId, storeId])
}

model CouponOnCategories {
  couponId  Int
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  categoryId Int
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
}

model ProductElement {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  type      ElementType
  unit      String
  image     String?
  compositions ProductComposition[]
}

model ProductComposition {
  id               Int            @id @default(autoincrement())
  productId        Int
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  elementId        Int
  element          ProductElement @relation(fields: [elementId], references: [id])
  quantity         Int            @default(1)
  elementType      ElementType    

  @@index([productId])
}

model Order {
  id                   Int           @id @default(autoincrement())
  totalAmount          Decimal       @db.Decimal(12, 2)
  subtotalBaseAmount   Decimal       @default(0) @db.Decimal(12, 2)
  subtotalAmount       Decimal       @default(0) @db.Decimal(12, 2)
  subtotalAfterLineDiscounts Decimal @default(0) @db.Decimal(12, 2)
  deliveryFee          Decimal       @default(0) @db.Decimal(12, 2)
  lineDiscountAmount   Decimal       @default(0) @db.Decimal(12, 2)
  couponDiscountAmount Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount       Decimal       @default(0) @db.Decimal(12, 2)
  commissionRuleId     Int?
  commissionRule       CommissionRule? @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)
  settlementStatus     SettlementStatus @default(PENDING)
  commissionRate       Decimal       @default(0) @db.Decimal(5, 2)
  commissionBaseAmount Decimal       @default(0) @db.Decimal(12, 2)
  platformCommissionAmount Decimal   @default(0) @db.Decimal(12, 2)
  systemServiceFeeAmount Decimal     @default(0) @db.Decimal(12, 2)
  platformTotalShareAmount Decimal   @default(0) @db.Decimal(12, 2)
  vendorShareAmount    Decimal       @default(0) @db.Decimal(12, 2)
  settlementHoldDays   Int           @default(7)
  complaintWindowHours Int           @default(24)
  settlementAutoReleaseEnabled Boolean @default(true)
  settlementEligibleAt DateTime?
  earningsHeldAt       DateTime?
  earningsReleasedAt   DateTime?
  settlementReleasedAmount Decimal @default(0) @db.Decimal(12, 2)
  settlementReversedAmount Decimal @default(0) @db.Decimal(12, 2)
  settlementReviewedAt DateTime?
  settlementReviewedByUserId Int?
  couponCode           String?
  couponTitle          String?
  couponApplyOn        CouponApplyOn?
  pricingSnapshot      Json?
  financialSnapshot    Json?
  status               OrderStatus   @default(PENDING)
  paymentStatus        PaymentStatus @default(PENDING)
  paymentRefundedAmount Decimal      @default(0) @db.Decimal(12, 2)
  paymentMethod        PaymentMethod @default(COD)
  shippingAddressId    Int?
  shippingAddressTitle String?
  shippingAddressText  String?       @db.Text
  shippingCity         String?
  shippingLat          Float?
  shippingLng          Float?
  storeId              Int?
  store                Store?        @relation(fields: [storeId], references: [id])
  storeName            String?
  storeSlug            String?
  deliveryType         DeliveryType?
  deliveryWindowLabel  String?
  estimatedDeliveryMinHours Int?
  estimatedDeliveryMaxHours Int?
  userId               Int
  user                 User          @relation(fields: [userId], references: [id])
  payment              Payment?
  couponRedemptions    CouponRedemption[]
  orderItems           OrderItem[]
  walletTransactions   WalletTransaction[]
  statusHistories      OrderStatusHistory[]
  supportTickets       SupportTicket[]
  domainEvents         DomainEvent[]
  reviews              Review[]
  notifications        Notification[]
  acceptedAt           DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

enum PaymentGateway {
  MOCK
}

model Payment {
  id              Int           @id @default(autoincrement())
  orderId          Int           @unique
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId           Int
  user             User          @relation(fields: [userId], references: [id])
  gatewayConfigId  Int?
  gatewayConfig    PaymentGatewayConfig? @relation(fields: [gatewayConfigId], references: [id], onDelete: SetNull)
  gateway          String
  gatewayKey       String?
  authority        String        @unique
  refId            String?
  amount           Decimal       @db.Decimal(12, 2)
  status           PaymentStatus @default(PENDING)
  refundedAmount   Decimal       @default(0) @db.Decimal(12, 2)
  reviewStatus     PaymentReviewStatus @default(NONE)
  paymentUrl       String?
  failureReason    String?       @db.Text
  reviewReason     String?       @db.Text
  reviewNote       String?       @db.Text
  initiatedAt      DateTime?
  expiresAt        DateTime?
  verifiedAt       DateTime?
  reviewedAt       DateTime?
  reviewedByUserId Int?
  attemptCount     Int           @default(0)
  gatewaySnapshot  Json?
  rawInitiateData  Json?
  rawVerifyData    Json?
  domainEvents     DomainEvent[]
  notifications    Notification[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([gatewayConfigId])
  @@index([userId])
  @@index([status])
}

model PaymentGatewayConfig {
  id               Int       @id @default(autoincrement())
  key              String    @unique
  displayName      String
  driver           String
  isActive         Boolean   @default(true)
  isDefault        Boolean   @default(false)
  priority         Int       @default(100)
  sandboxMode      Boolean   @default(true)
  merchantConfig   Json?
  technicalConfig  Json?
  callbackUrl      String?
  returnUrl        String?
  notes            String?   @db.Text
  metadata         Json?
  payments         Payment[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([isActive, isDefault])
  @@index([priority])
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  REJECTED_BY_VENDOR
  CANCELLED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum PaymentReviewStatus {
  NONE
  NEEDS_REVIEW
  UNDER_REVIEW
  RESOLVED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum DeliveryType {
  STANDARD
  EXPRESS
}

enum SettlementStatus {
  PENDING
  ELIGIBLE
  PROCESSING
  SETTLED
  ON_HOLD
  REVERSED
}

enum SupportTicketStatus {
  OPEN
  IN_REVIEW
  WAITING_CUSTOMER
  WAITING_VENDOR
  ESCALATED_TO_FINANCE
  RESOLVED
  REJECTED
  CANCELLED
}

enum SupportTicketReason {
  DAMAGED_FLOWERS
  MISMATCHED_PRODUCT
  LATE_DELIVERY
  INCOMPLETE_OR_WRONG_ORDER
  DELIVERY_EXPERIENCE
  OTHER
}

enum SupportTicketFinanceOutcome {
  NO_ACTION_RELEASE
  FULL_REFUND
  PARTIAL_REFUND
  FULL_REVERSAL
  PARTIAL_REVERSAL
  EXTEND_HOLD
}

enum SupportTicketActorType {
  CUSTOMER
  VENDOR
  ADMIN
  FINANCE
  SYSTEM
}

enum CommissionRuleScope {
  GLOBAL
  STORE
}

enum WalletTransactionType {
  ORDER_EARNING
  ORDER_RELEASE
  ORDER_REVERSAL
  MANUAL_CREDIT
  MANUAL_DEBIT
  PROMOTION_SPEND
  TOP_UP
  SETTLEMENT_PAYOUT
  ADJUSTMENT
}

enum WalletTransactionDirection {
  CREDIT
  DEBIT
}

enum VendorHealthStatus {
  EXCELLENT
  GOOD
  WATCHLIST
  AT_RISK
}

enum ProductPublicationStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum VendorOnboardingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model VendorOnboardingRequest {
  id                     Int                   @id @default(autoincrement())
  userId                 Int                   @unique
  user                   User                  @relation("VendorOnboardingOwner", fields: [userId], references: [id], onDelete: Cascade)
  applicationStatus      VendorOnboardingStatus @default(DRAFT)
  productStatus          VendorOnboardingStatus @default(DRAFT)
  personalFullName       String?
  personalNationalId     String?
  businessName           String?
  businessSlug           String?
  businessDescription    String?               @db.Text
  businessAddress        String?               @db.Text
  businessLat            Float?
  businessLng            Float?
  licenseNumber          String?
  licenseImageUrl        String?
  documents              Json?
  productName            String?
  productDescription     String?               @db.Text
  productCategoryId      Int?
  productTypeId          Int?
  productMainImage       String?
  productPrice           Decimal?              @db.Decimal(12, 2)
  productQuantity        Int?
  submittedAt            DateTime?
  reviewedAt             DateTime?
  reviewedByUserId       Int?
  reviewNote             String?               @db.Text
  productSubmittedAt     DateTime?
  productReviewedAt      DateTime?
  productReviewedByUserId Int?
  productReviewNote      String?               @db.Text
  storeActivatedAt       DateTime?
  reviewedByUser         User?                 @relation("VendorOnboardingReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  productReviewedByUser  User?                 @relation("VendorOnboardingProductReviewedBy", fields: [productReviewedByUserId], references: [id], onDelete: SetNull)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([applicationStatus, updatedAt])
  @@index([productStatus, updatedAt])
}

enum DomainEventType {
  ORDER_CREATED
  ORDER_ACCEPTED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_INITIATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_EXPIRED
  PAYMENT_REFUNDED
  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_STATUS_CHANGED
  SUPPORT_FINANCE_DECISION_APPLIED
  SETTLEMENT_HELD
  SETTLEMENT_RELEASED
  SETTLEMENT_REVERSED
  WALLET_ADJUSTED
}

enum DomainEventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}


model CommissionRule {
  id                    Int                 @id @default(autoincrement())
  scope                 CommissionRuleScope @default(GLOBAL)
  storeId               Int?
  store                 Store?              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title                 String
  description           String?             @db.Text
  commissionRate        Decimal             @db.Decimal(5, 2)
  systemServiceFeeRate  Decimal             @default(0) @db.Decimal(5, 2)
  systemServiceFeeFixed Decimal             @default(0) @db.Decimal(12, 2)
  settlementHoldDays    Int                 @default(7)
  complaintWindowHours  Int                 @default(24)
  autoReleaseEnabled    Boolean             @default(true)
  priority              Int                 @default(100)
  isActive              Boolean             @default(true)
  startAt               DateTime?
  endAt                 DateTime?
  reason                String?             @db.Text
  createdByUserId       Int?
  metadata              Json?
  orders                Order[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([scope, isActive, priority])
  @@index([storeId, isActive, priority])
}

model StoreWallet {
  id               Int                 @id @default(autoincrement())
  storeId          Int                 @unique
  store            Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  currentBalance   Decimal             @default(0) @db.Decimal(12, 2)
  availableBalance Decimal             @default(0) @db.Decimal(12, 2)
  heldBalance      Decimal             @default(0) @db.Decimal(12, 2)
  transactions     WalletTransaction[]
  domainEvents     DomainEvent[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model WalletTransaction {
  id              Int                      @id @default(autoincrement())
  walletId         Int
  wallet           StoreWallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  storeId          Int
  store            Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId          Int?
  order            Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type             WalletTransactionType
  direction        WalletTransactionDirection
  amount           Decimal                 @db.Decimal(12, 2)
  title            String
  description      String?                 @db.Text
  batchKey         String?
  createdByUserId  Int?
  metadata         Json?
  createdAt        DateTime                @default(now())

  @@index([walletId, createdAt])
  @@index([storeId, createdAt])
  @@index([orderId])
}

model SupportTicket {
  id                    Int                         @id @default(autoincrement())
  orderId               Int
  order                 Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId            Int
  customer              User                        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  storeId               Int?
  store                 Store?                      @relation(fields: [storeId], references: [id], onDelete: SetNull)
  reason                SupportTicketReason
  status                SupportTicketStatus         @default(OPEN)
  title                 String
  description           String                      @db.Text
  customerEvidence      Json?
  internalNote          String?                     @db.Text
  financeOutcome        SupportTicketFinanceOutcome?
  financeAmount         Decimal?                    @db.Decimal(12, 2)
  financeNote           String?                     @db.Text
  settlementBlockedAt   DateTime?
  escalatedAt           DateTime?
  resolvedAt            DateTime?
  resolvedByUserId      Int?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  notes                 SupportTicketNote[]
  domainEvents          DomainEvent[]
  notifications         Notification[]

  @@index([orderId])
  @@index([customerId, createdAt])
  @@index([storeId, createdAt])
  @@index([status, createdAt])
}

model SupportTicketNote {
  id          Int                    @id @default(autoincrement())
  ticketId    Int
  ticket      SupportTicket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorType   SupportTicketActorType
  actorUserId Int?
  message     String                 @db.Text
  isInternal  Boolean                @default(false)
  metadata    Json?
  createdAt   DateTime               @default(now())

  @@index([ticketId, createdAt])
}

enum OrderActorType {
  CUSTOMER
  VENDOR
  ADMIN
  SYSTEM
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  quantity     Int
  price        Decimal  @db.Decimal(12, 2)
  pricingSnapshot Json?
  productName  String?
  productSlug  String?
  productImage String?
  storeId      Int?
  storeName    String?
  storeSlug    String?
  orderId      Int
  order        Order    @relation(fields: [orderId], references: [id])
  productId    Int
  product      Product  @relation(fields: [productId], references: [id])
}

model OrderStatusHistory {
  id          Int            @id @default(autoincrement())
  orderId     Int
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorType   OrderActorType
  actorUserId Int?
  reason      String?        @db.Text
  note        String?        @db.Text
  createdAt   DateTime       @default(now())

  @@index([orderId])
}

model Review {
  id            Int      @id @default(autoincrement())
  rating        Int      @default(5)
  comment       String?  @db.Text
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  productId     Int
  product       Product  @relation(fields: [productId], references: [id])
  orderId       Int      @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([userId, productId])
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  phoneNumber String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phoneNumber])
}

model Notification {
  id            Int                 @id @default(autoincrement())
  userId        Int
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId       Int?
  store         Store?              @relation(fields: [storeId], references: [id], onDelete: SetNull)
  orderId       Int?
  order         Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentId     Int?
  payment       Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  supportTicketId Int?
  supportTicket SupportTicket?      @relation(fields: [supportTicketId], references: [id], onDelete: SetNull)
  channel       NotificationChannel @default(IN_APP)
  status        NotificationStatus  @default(PENDING)
  topic         String
  templateKey   String?
  title         String
  body          String              @db.Text
  payload       Json?
  templateData  Json?
  attempts      Int                 @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  failedAt      DateTime?
  cancelledAt   DateTime?
  failureReason String?             @db.Text
  providerResponse Json?
  providerMessageId String?
  dedupeKey     String?             @unique
  deliveries    NotificationDelivery[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([storeId, createdAt])
  @@index([orderId, createdAt])
}

model NotificationDelivery {
  id                Int                 @id @default(autoincrement())
  notificationId    Int
  notification      Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId            Int
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId           Int?
  store             Store?              @relation(fields: [storeId], references: [id], onDelete: SetNull)
  channel           NotificationChannel
  status            NotificationStatus  @default(PENDING)
  title             String
  body              String              @db.Text
  attempts          Int                 @default(0)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  cancelledAt       DateTime?
  failureReason     String?             @db.Text
  providerResponse  Json?
  providerMessageId String?
  dedupeKey         String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([notificationId, createdAt])
  @@index([userId, createdAt])
  @@index([storeId, createdAt])
  @@index([channel, createdAt])
  @@index([status, createdAt])
}

model DomainEvent {
  id              Int               @id @default(autoincrement())
  eventType       DomainEventType
  aggregateType   String
  aggregateId     Int
  status          DomainEventStatus @default(PENDING)
  actorUserId     Int?
  storeId         Int?
  orderId         Int?
  paymentId       Int?
  supportTicketId Int?
  walletId        Int?
  summary         String?
  payload         Json?
  metadata        Json?
  processedAt     DateTime?
  failureReason   String?           @db.Text
  createdAt       DateTime          @default(now())

  store           Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  order           Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment         Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  supportTicket   SupportTicket?    @relation(fields: [supportTicketId], references: [id], onDelete: SetNull)
  wallet          StoreWallet?      @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([aggregateType, aggregateId, createdAt])
  @@index([eventType, createdAt])
  @@index([status, createdAt])
  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
  @@index([supportTicketId, createdAt])
  @@index([storeId, createdAt])
  @@index([walletId, createdAt])
}
