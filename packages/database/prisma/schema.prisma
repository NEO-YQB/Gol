datasource db {
  provider = "postgresql"
  url      = env("MY_NEW_DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ۱. مدل کاربران (ادمین، فروشنده، مشتری)
model User {
  id            Int      @id @default(autoincrement())
  phoneNumber   String   @unique
  email         String?  @unique
  fullName      String?
  role          Role     @default(CUSTOMER)
  isActive      Boolean  @default(true)
  
  // روابط
  addresses     UserAddress[]
  store         Store?
  orders        Order[]
  reviews       Review[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum Role {
  ADMIN
  VENDOR
  CUSTOMER
}

// ۲. مدل فروشگاه (برای چندفروشندگی)
model Store {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  description   String?  @db.Text
  logo          String?
  
  // مختصات فروشگاه برای جستجوی مکانی
  lat           Float?
  lng           Float?
  address       String?

  isVerified    Boolean  @default(false)
  
  // روابط
  ownerId       Int      @unique
  owner         User     @relation(fields: [ownerId], references: [id])
  products      Product[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserAddress {
  id        Int      @id @default(autoincrement())
  title     String
  address   String   @db.Text
  city      String
  lat       Float
  lng       Float
  isDefault Boolean  @default(false)
  
  // روابط
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ElementType {
  BASE
  FLOWER
  FILLER
  ACCESSORY
}

// ۳. مدل محصولات
model Product {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  shortDescription String? @db.Text
  
  quantity      Int      @default(0)
  price           Float
  discountPrice   Float?   // قیمت با تخفیف
  
  // رسانه
  mainImage       String
  images          Json?    // آرایه‌ای از URLها
  videoUrl        String?

  // روابط اصلی
  storeId         Int
  store           Store    @relation(fields: [storeId], references: [id])
  
  productTypeId   Int
  productType     ProductType @relation(fields: [productTypeId], references: [id])
  
  categoryId      Int
  category        Category    @relation(fields: [categoryId], references: [id])

  // اجزای تشکیل دهنده
  composition     ProductComposition[]

  // سوابق و نظرات
  orderItems      OrderItem[]
  reviews         Review[]

  // SEO
  metaTitle       String?
  metaDescription String?
  isIndexed       Boolean     @default(true)
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model ProductType {
  id              Int      @id @default(autoincrement())
  name            String   // مثلا: باکس گل، تاج گل، دسته گل
  slug            String   @unique
  description     String?  @db.Text
  image           String?
  
  // SEO
  metaTitle       String?
  metaDescription String?
  isIndexed       Boolean  @default(true)
  
  // فیلتر برای محدودسازی اجزا در پنل مدیریت
  allowedElements Json?    

  products        Product[]
  createdAt       DateTime @default(now())
}

// ۴. مدل دسته‌بندی
model Category {
  id              Int      @id @default(autoincrement())
  name            String   // مثلا: ولنتاین، ترحیم، تولد
  slug            String   @unique
  description     String?  @db.Text
  image           String?
  
  // SEO & Campaign logic
  metaTitle       String?
  metaDescription String?
  isIndexed       Boolean  @default(true)
  isCampaign      Boolean  @default(false)

  products        Product[]
  createdAt       DateTime @default(now())
}

model ProductElement {
  id          Int          @id @default(autoincrement())
  name        String       @unique // مثلا: رز هلندی قرمز، باکس چوبی مربع
  type        ElementType  
  unit        String       @default("شاخه") 
  image       String?      
  
  compositions ProductComposition[]
}

model ProductComposition {
  id               Int            @id @default(autoincrement())
  
  productId        Int
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  elementId        Int
  element          ProductElement @relation(fields: [elementId], references: [id])
  
  quantity         Int            @default(1)
  
  // ذخیره نوع در اینجا برای کوئری‌های سریع فرانت
  elementType      ElementType    

  @@index([productId])
}

// ۵. مدل سفارشات
model Order {
  id            Int         @id @default(autoincrement())
  totalAmount   Decimal     @db.Decimal(12, 2)
  status        OrderStatus @default(PENDING)
  
  // روابط
  userId        Int
  user          User        @relation(fields: [userId], references: [id])
  orderItems    OrderItem[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// ۶. جزئیات سفارش
model OrderItem {
  id            Int      @id @default(autoincrement())
  quantity      Int
  price         Decimal  @db.Decimal(12, 2)

  // روابط
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id])
  productId     Int
  product       Product  @relation(fields: [productId], references: [id])
}

// ۷. نظرات
model Review {
  id            Int      @id @default(autoincrement())
  rating        Int      @default(5)
  comment       String?  @db.Text
  
  // روابط
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  productId     Int
  product       Product  @relation(fields: [productId], references: [id])

  createdAt     DateTime @default(now())
}

// ۸. کد تایید
model OtpCode {
  id        Int      @id @default(autoincrement())
  phoneNumber String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phoneNumber])
}
