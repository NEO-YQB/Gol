datasource db {
  provider = "postgresql"
  url      = env("MY_NEW_DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ۱. مدل کاربران (User) - تغییر یافته برای پشتیبانی از نقش‌های داینامیک
model User {
  id            Int      @id @default(autoincrement())
  phoneNumber   String   @unique
  email         String?  @unique
  fullName      String?
  isActive      Boolean  @default(true)
  
  // رابطه با نقش‌ها (یک کاربر می‌تواند چندین نقش داشته باشد)
  roles         UsersOnRoles[]

  // روابط قبلی
  addresses     UserAddress[]
  cart          Cart?
  store         Store?
  orders        Order[]
  reviews       Review[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ۲. مدل نقش‌ها (مثلا: Admin, Vendor, Editor)
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // نام انگلیسی: ADMIN
  label       String?  // نام فارسی: مدیر کل
  description String?

  users       UsersOnRoles[]
  permissions RolesOnPermissions[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ۳. مدل دسترسی‌ها (مثلا: create:product, delete:order)
model Permission {
  id          Int      @id @default(autoincrement())
  action      String   // مثلا: create, read, update, delete
  subject     String   // مثلا: Product, Order, User
  inverted    Boolean  @default(false) // برای استثنا قائل شدن
  conditions  Json?    // برای دسترسی‌های شرطی (مثلا فقط محصول خودش)

  roles       RolesOnPermissions[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([action, subject])
}

// ۴. جدول واسط کاربر و نقش (Many-to-Many)
model UsersOnRoles {
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ۵. جدول واسط نقش و دسترسی (Many-to-Many)
model RolesOnPermissions {
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ۶. مدل فروشگاه (بدون تغییر نسبت به نسخه قبل)
model Store {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  description   String?  @db.Text
  logo          String?
  lat           Float?
  lng           Float?
  address       String?
  isVerified    Boolean  @default(false)
  sameDayDelivery Boolean @default(false)
  hasExpressDelivery Boolean @default(false)
  minDeliveryHours Int?
  maxDeliveryHours Int?
  expressDeliveryHours Int?
  deliveryWindows Json?
  
  ownerId       Int      @unique
  owner         User     @relation(fields: [ownerId], references: [id])
  products      Product[]
  orders        Order[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserAddress {
  id        Int      @id @default(autoincrement())
  title     String
  address   String   @db.Text
  city      String
  lat       Float
  lng       Float
  isDefault Boolean  @default(false)
  
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId     Int       @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model CartItem {
  id         Int      @id @default(autoincrement())
  cartId     Int
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
}

enum ElementType {
  BASE
  FLOWER
  FILLER
  ACCESSORY
}

// ۷. مدل محصولات
model Product {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  shortDescription String? @db.Text
  quantity        Int      @default(0)
  price           Float
  discountPrice   Float?
  mainImage       String
  images          Json?
  videoUrl        String?

  storeId         Int
  store           Store    @relation(fields: [storeId], references: [id])
  productTypeId   Int
  productType     ProductType @relation(fields: [productTypeId], references: [id])
  categoryId      Int
  category        Category    @relation(fields: [categoryId], references: [id])

  composition     ProductComposition[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]

  metaTitle       String?
  metaDescription String?
  isIndexed       Boolean     @default(true)
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model ProductType {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  image           String?
  metaTitle       String?
  metaDescription String?
  isIndexed       Boolean  @default(true)
  allowedElements Json?    
  products        Product[]
  createdAt       DateTime @default(now())
}

model Category {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  image           String?
  parentId        Int?
  parent          Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryToCategory")
  metaTitle       String?
  metaDescription String?
  isIndexed       Boolean  @default(true)
  isCampaign      Boolean  @default(false)
  products        Product[]
  createdAt       DateTime @default(now())
}

model ProductElement {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  type        ElementType  
  unit        String       @default("شاخه") 
  image       String?      
  compositions ProductComposition[]
}

model ProductComposition {
  id               Int            @id @default(autoincrement())
  productId        Int
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  elementId        Int
  element          ProductElement @relation(fields: [elementId], references: [id])
  quantity         Int            @default(1)
  elementType      ElementType    

  @@index([productId])
}

model Order {
  id                   Int           @id @default(autoincrement())
  totalAmount          Decimal       @db.Decimal(12, 2)
  subtotalAmount       Decimal       @default(0) @db.Decimal(12, 2)
  deliveryFee          Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount       Decimal       @default(0) @db.Decimal(12, 2)
  status               OrderStatus   @default(PENDING)
  paymentStatus        PaymentStatus @default(PENDING)
  paymentMethod        PaymentMethod @default(COD)
  shippingAddressId    Int?
  shippingAddressTitle String?
  shippingAddressText  String?       @db.Text
  shippingCity         String?
  shippingLat          Float?
  shippingLng          Float?
  storeId              Int?
  store                Store?        @relation(fields: [storeId], references: [id])
  storeName            String?
  storeSlug            String?
  deliveryType         DeliveryType?
  deliveryWindowLabel  String?
  estimatedDeliveryMinHours Int?
  estimatedDeliveryMaxHours Int?
  userId               Int
  user                 User          @relation(fields: [userId], references: [id])
  orderItems           OrderItem[]
  statusHistories      OrderStatusHistory[]
  acceptedAt           DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  REJECTED_BY_VENDOR
  CANCELLED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum DeliveryType {
  STANDARD
  EXPRESS
}

enum OrderActorType {
  CUSTOMER
  VENDOR
  ADMIN
  SYSTEM
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  quantity     Int
  price        Decimal  @db.Decimal(12, 2)
  productName  String?
  productSlug  String?
  productImage String?
  storeId      Int?
  storeName    String?
  storeSlug    String?
  orderId      Int
  order        Order    @relation(fields: [orderId], references: [id])
  productId    Int
  product      Product  @relation(fields: [productId], references: [id])
}

model OrderStatusHistory {
  id          Int            @id @default(autoincrement())
  orderId     Int
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorType   OrderActorType
  actorUserId Int?
  reason      String?        @db.Text
  note        String?        @db.Text
  createdAt   DateTime       @default(now())

  @@index([orderId])
}

model Review {
  id            Int      @id @default(autoincrement())
  rating        Int      @default(5)
  comment       String?  @db.Text
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  productId     Int
  product       Product  @relation(fields: [productId], references: [id])
  createdAt     DateTime @default(now())
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  phoneNumber String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phoneNumber])
}
