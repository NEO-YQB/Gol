{
  "name": "flower-marketplace",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev -w apps/backend",
    "dev:storefront": "npm run dev -w apps/storefront",
    "dev:admin": "npm run dev -w apps/admin-panel",
    "dev:vendor": "npm run dev -w apps/vendor-panel",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:storefront\" \"npm run dev:admin\" \"npm run dev:vendor\"",
    "build": "npm run build --workspaces"
  },
  "dependencies": {
    "@casl/ability": "^6.8.0",
    "@casl/prisma": "^1.6.2",
    "@nestjs/config": "^4.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/swagger": "^11.2.7",
    "@prisma/client": "^6.19.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "slugify": "^1.6.9",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^8.3.4",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.14",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0"
  },
  "prisma": {
    "seed": "npx tsx packages/database/prisma/seed.ts"
  }
}
