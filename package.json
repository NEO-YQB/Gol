{
  "name": "flower-marketplace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev -w apps/backend",
    "dev:storefront": "npm run dev -w apps/storefront",
    "build": "npm run build --workspaces"
  },
  "dependencies": {
    "@nestjs/config": "^4.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@prisma/client": "^6.19.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.19.3"
  },
  "prisma": {
    "seed": "ts-node packages/database/prisma/seed.ts"
  }
}
